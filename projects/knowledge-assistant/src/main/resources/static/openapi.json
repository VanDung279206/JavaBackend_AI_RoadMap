{
  "openapi": "3.0.3",
  "info": {
    "title": "Knowledge Assistant teaching API",
    "version": "1.0.0",
    "description": "Teaching API contract for Spring Boot 3.5: owner-scoped CRUD, demo/live AI modes and request IDs. Demo responses are not model verification."
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/documents": {
      "post": {
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentView"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Missing or outside owner scope",
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteDocument"
              }
            }
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPage"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Missing or outside owner scope",
            "headers": {
              "X-Request-ID": {
                "description": "Validated incoming ID or generated UUID",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
