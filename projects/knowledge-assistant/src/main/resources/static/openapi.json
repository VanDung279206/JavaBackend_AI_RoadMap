  "components": {
    "schemas": {
      "WriteDocument": {
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "additionalProperties": false
      },
      "UpdateDocument": {
        "type": "object",
        "required": [
          "title",
          "content",
          "expectedVersion"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Question": {
        "type": "object",
        "required": [
          "question",
          "k"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "additionalProperties": false
      },
      "DocumentView": {
        "type": "object",
        "required": [
          "id",
          "title",
          "content",
          "createdAt",
          "version"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DocumentPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "totalElements"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentView"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "title",
          "bullets"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SummaryResponse": {
        "type": "object",
        "required": [
          "mode",
          "summary"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          }
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "id",
          "documentId",
          "version",
          "title",
          "text",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "documentId": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "AnswerResponse": {
        "type": "object",
        "required": [
          "mode",
          "status",
          "answer",
          "sources"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        }
      },
      "IndexResponse": {
        "type": "object",
        "required": [
          "documentId",
          "chunks",
          "mode"
        ],
        "properties": {
          "documentId": {
            "type": "integer",
            "format": "int64"
          },
          "chunks": {
            "type": "integer"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
