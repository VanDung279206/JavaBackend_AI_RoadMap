    "/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Process health, not model readiness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
